# Contact form. All three are required before /api/contact will send mail.
# If any are missing, the form shows a friendly error and the server logs which names are unset.
RESEND_API_KEY=
CONTACT_TO_EMAIL=nicholaswutke@gmail.com
CONTACT_FROM_EMAIL=Wutke Media <hello@your-verified-domain.com>

# Optional. Used for canonical URLs, Open Graph, and the sitemap.
# On Vercel this falls back to the deployment host when unset.
NEXT_PUBLIC_SITE_URL=https://example.com
